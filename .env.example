# GitHub Readme Stats - Environment Variables Configuration
# Copy this file to .env and update the values with your actual credentials

# =============================================================================
# REQUIRED: GitHub Personal Access Token
# =============================================================================
# Get your token from: https://github.com/settings/tokens
# Recommended scopes: repo, read:user
# The token should start with 'ghp_' when copied from GitHub
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Alternative variable name (use either GITHUB_TOKEN or PAT_1)
# PAT_1=ghp_your_github_personal_access_token_here

# =============================================================================
# OPTIONAL: Server Configuration
# =============================================================================
# Port to run the server on (default: 3000)
# PORT=3000

# =============================================================================
# OPTIONAL: Advanced Configuration
# =============================================================================
# Cache duration in seconds (default: 3600 = 1 hour)
# CACHE_SECONDS=3600

# Comma-separated list of allowed usernames (whitelist)
# Leave empty to allow all users
# WHITELIST=username1,username2,username3

# Comma-separated list of repositories to exclude from stats
# EXCLUDE_REPO=repo1,repo2,private-repo

# Enable debug logging (true/false)
# DEBUG=false

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# - Never commit your actual .env file to version control
# - In production, set these variables in your hosting platform's dashboard
# - Railway, Heroku, Vercel, etc. all support environment variables
# - For local development, copy this file to .env and update the values
